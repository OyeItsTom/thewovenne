# ─────────────────────────────────────────────
# THE WOVENNE — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────

# Site URL used to build Stripe success/cancel redirect links.
# In local dev this is usually http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key — server-side only, used by admin/API routes that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Stripe (UK / card payments) ────────────────
# Secret key from Stripe Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=your-stripe-secret-key
# Publishable key, safe for the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
# Signing secret for the /api/webhooks/stripe endpoint (Stripe CLI or Dashboard → Webhooks).
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# ── Razorpay (India / international payments) ─
# Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Public key id, exposed to the browser checkout.js widget.
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

# ── WhatsApp ────────────────────────────────────
# Full international number, digits only (no +, spaces, or dashes). e.g. 447123456789
NEXT_PUBLIC_WHATSAPP_NUMBER=447000000000
