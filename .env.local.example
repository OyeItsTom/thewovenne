# ─────────────────────────────────────────────
# THE WOVENNE — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────

# Site URL used to build Stripe success/cancel redirect links.
# In local dev this is usually http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key — server-side only, used by admin/API routes that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Razorpay (sole checkout — India/Kerala: UPI, GPay, cards) ─
# Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Public key id, exposed to the browser checkout.js widget.
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

# ── PayPal (DISABLED — future UK checkout) ────
# TODO(payments): Razorpay is the only provider for now. When adding PayPal for
# UK customers, uncomment and fill these, and re-add the PayPal button/route.
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# ── Anthropic (Ask Wovenne AI concierge) ──────
# console.anthropic.com → API Keys. Server-side only — never expose to the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Sentry (error monitoring — OPTIONAL) ──────
# Leave these commented out to run without Sentry. Only uncomment and paste a
# real DSN (a URL from Sentry → Settings → Client Keys) to enable it — a
# placeholder value is ignored, so an empty/commented DSN keeps Sentry off.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── WhatsApp ────────────────────────────────────
# Full international number, digits only (no +, spaces, or dashes). e.g. 447123456789
NEXT_PUBLIC_WHATSAPP_NUMBER=447000000000
# WhatsApp Business API webhook verify token (for /api/whatsapp/webhook — set once you
# connect a provider like 360dialog or Twilio).
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token

# ── Transactional email (Resend) ──────────────
# Order confirmations are sent from application code via Resend's REST API.
RESEND_API_KEY=re_your-resend-api-key

# Sender. Must be on a domain verified in Resend, or Resend rejects the send.
# A real, monitored mailbox rather than noreply@: order mail invites replies
# ("can I change the address?"), and noreply@ sends those into a void.
EMAIL_FROM=THE WOVENNE <orders@thewovenne.com>

# Optional. Where replies go if that differs from EMAIL_FROM.
EMAIL_REPLY_TO=hello@thewovenne.com

# ── Auth emails are NOT sent from here ────────
# Signup codes and password resets are generated and sent by Supabase Auth, not
# by this application. Route them through Resend by setting Supabase's custom
# SMTP (Dashboard -> Project Settings -> Authentication -> SMTP) to Resend's
# SMTP credentials. Sending them from code would mean reimplementing the flows
# that mint those tokens, and hand-rolling token handling around Supabase's own
# is how auth bugs happen.
