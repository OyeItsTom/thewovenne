# ─────────────────────────────────────────────
# THE WOVENNE — STAGING environment
# Copy to .env.staging (gitignored) and fill from the wovenne-staging Supabase
# project. NOTHING in this file may come from production: the scripts and the
# build refuse the production project (wxumlixnmwgeqswknhpw) whenever
# WOVENNE_ENV=staging. See docs/staging.md.
# ─────────────────────────────────────────────

# Declares this file as staging. Staging-only scripts (scripts/staging.mjs)
# refuse to run without it, and the app refuses to start against production
# with it.
WOVENNE_ENV=staging

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase: wovenne-staging ─────────────────
# Dashboard → wovenne-staging → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<staging-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard → Connect → Session pooler (works on IPv4). Either shape is fine:
#   postgresql://postgres.<staging-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   postgresql://postgres:<password>@db.<staging-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# ── Razorpay: TEST mode keys only (rzp_test_…) ─
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# A webhook secret of its own — not production's.
RAZORPAY_WEBHOOK_SECRET=

# ── Email: leave RESEND_API_KEY unset to send nothing ─
# lib/email.ts skips sending without a key. If you do set one, use a key
# restricted to sending, and only send to addresses you own.
# RESEND_API_KEY=
# EMAIL_FROM=THE WOVENNE STAGING <orders@thewovenne.com>

# ── Anthropic: a separate key with a low spend cap ─
# Leave unset to keep Ask Wovenne off on staging.
# ANTHROPIC_API_KEY=

# ── Sentry: optional. Locally there is no VERCEL_ENV, so name it. ─
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging
